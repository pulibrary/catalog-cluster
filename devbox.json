{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.19.0/.schema/devbox.schema.json",
  "packages": [
    "rustup@latest",
    "cargo-llvm-cov",
    "git",
    "semgrep",
    "postgresql@18",
    "postgresql.dev",
    "diesel-cli@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "setup": [
        "test -f \"$PGDATA/PG_VERSION\" || initdb",
        "devbox services up -b 2>/dev/null || echo 'services already running'",
        "diesel setup"
      ]
    }
  }
}
